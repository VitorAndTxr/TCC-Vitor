    RESEARCH }|--o{ VOLUNTEER : possui
    RESEARCH }|--o{ RESEARCHER : possui
    RESEARCH }|--o{ DEVICE : possui
    DEVICE ||--o{ SENSOR : compoe

    %% Familia 2 -> Familia 3
    RESEARCH ||--o{ RECORD_SESSION : executa
    VOLUNTEER ||--o{ RECORD_SESSION : participa
    RECORD_CHANNEL ||--o| SENSOR : mede

    %% Internos a Familia 3
    RECORD_SESSION ||--|{ RECORD : contem
    RECORD_SESSION ||--o{ SESSION_ANNOTATION : anota
    RECORD_SESSION ||--|{ TARGET_AREA : ocorre_em
    RECORD ||--|{ RECORD_CHANNEL : cataloga

    %% Familia 3 -> Familia 4
    TARGET_AREA ||--|| SNOMED_BODY_STRUCTURE : "aplica-se a" 
    TARGET_AREA ||--o| SNOMED_LATERALITY : tem
    TARGET_AREA ||--o{ SNOMED_TOPOGRAPHICAL_MODIFIER : tem

    %% Familia 2 -> Familia 4
    VOLUNTEER }|--o{ CLINICAL_CONDITION : possui

